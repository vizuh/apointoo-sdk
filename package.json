{
  "name": "@vizuh/apointoo-sdk",
  "version": "0.12.2",
  "private": false,
  "description": "Headless TypeScript SDK for booking, intake, attribution, auth, queues, notifications, and conversion workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizuh/apointoo-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/vizuh/apointoo-sdk/issues"
  },
  "homepage": "https://github.com/vizuh/apointoo-sdk#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./adapters/booking/blvd": "./dist/adapters/booking/blvd/index.js",
    "./adapters/booking/direct-confirm": "./dist/adapters/booking/direct-confirm/index.js",
    "./adapters/booking/recal": "./dist/adapters/booking/recal/index.js",
    "./adapters/persistence/sheets": "./dist/adapters/persistence/sheets/index.js",
    "./adapters/notification/brevo-rest": "./dist/adapters/notification/brevo-rest/index.js",
    "./adapters/dedup/upstash": "./dist/adapters/dedup/upstash.js",
    "./adapters/ledger": "./dist/adapters/ledger/adapter.js",
    "./adapters/ledger/memory": "./dist/adapters/ledger/memory.js",
    "./adapters/ledger/mongodb": "./dist/adapters/ledger/mongodb.js",
    "./adapters/audit": "./dist/adapters/audit/index.js",
    "./adapters/conversion": "./dist/adapters/conversion/index.js",
    "./adapters/conversion/memory": "./dist/adapters/conversion/memory/index.js",
    "./adapters/dedup/memory": "./dist/adapters/dedup/memory.js",
    "./adapters/manifests": "./dist/adapters/manifest-registry.js",
    "./auth": "./dist/auth/index.js",
    "./server": "./dist/server/index.js"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "cross-env LIVE=1 vitest run tests/live",
    "test:ci": "npm run typecheck && vitest run --coverage --reporter=github-actions",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "husky || true",
    "prepack": "npm run build",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "zod": {
      "optional": false
    }
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "jose": "^6.2.3",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "googleapis": "^171.4.0",
    "hono": "^4.12.23",
    "mongodb": "^6.13.0",
    "recal-sdk": "^1.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "husky": "^9.0.0",
    "prettier": "^3.8.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
