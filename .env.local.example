# ─── apointoo-headless-booking — environment ────────────────────────────────
# Copy to .env.local. Never commit .env.local.

# ── Booking adapter: BLVD (Boulevard) ───────────────────────────────────────
# Sandbox: https://sandbox.joinblvd.com/api/2020-01
# Live:    https://dashboard.boulevard.io/api/2020-01
BLVD_API_URL=https://sandbox.joinblvd.com/api/2020-01
BLVD_API_KEY=
BLVD_BUSINESS_ID=
BLVD_DEFAULT_LOCATION_ID=

# ── Persistence adapter: Google Sheets ──────────────────────────────────────
# Service account from Google Cloud. Share the spreadsheet with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor. PRIVATE_KEY stays as-is — the helper
# unescapes literal \n. Do NOT wrap in quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Bookings

# ── Notification adapter: Brevo (REST API, not SMTP) ────────────────────────
# Generate at Brevo dashboard → SMTP & API → API tab (different from SMTP key).
BREVO_API_KEY=
LEAD_FROM_EMAIL=
LEAD_FROM_NAME=
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_BCC=

# ── Dedup + ratelimit: Upstash Redis ────────────────────────────────────────
# Optional in dev (memory store fallback). Required in serverless prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── State store + queue: Supabase (ADR-006) ─────────────────────────────────
# Optional in dev (memory impls work). Required in prod for resilience.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp notifier: Twilio (ADR-005) ─────────────────────────────────────
# Optional. Use the API key (Account SID + Auth Token), not SMTP key.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_BOOKING_TEMPLATE_SID=
TWILIO_BOOKING_TO=

# ── OpenDental adapter (ADR-008 — skeleton, not yet implemented) ────────────
OPENDENTAL_API_URL=
OPENDENTAL_CUSTOMER_KEY=
OPENDENTAL_DEVELOPER_KEY=
OPENDENTAL_CLINIC_NUM=

# ── Recal adapter (ADR-014 — calendar-backed booking via api.recal.dev) ─────
# Get your token at api.recal.dev. Token must start with "recal_".
RECAL_TOKEN=
RECAL_URL=https://api.recal.dev

# ── Reserve-with-Google publisher (ADR-009) ─────────────────────────────────
# SFTP creds. Private key path is read by the consumer; never the kit.
RWG_SFTP_HOST=partnerupload.google.com
RWG_SFTP_PORT=19321
RWG_SFTP_USERNAME=
RWG_SFTP_PRIVATE_KEY_PATH=

# ── Admin API (ADR-007 + admin endpoints) ───────────────────────────────────
# Bearer token for /admin/* read endpoints. Use staticTokenVerifier in dev.
ADMIN_API_TOKEN=

# ── Project ─────────────────────────────────────────────────────────────────
APOINTOO_PROJECT_KEY=apointoo-dev
APOINTOO_BUSINESS_NAME=
APOINTOO_TIMEZONE=America/New_York
APOINTOO_LOCALE=en-US

# ── Feature flags ───────────────────────────────────────────────────────────
APOINTOO_DEDUP_TTL_MS=90000
APOINTOO_RATELIMIT_PER_MINUTE=20
APOINTOO_LOG_LEVEL=info
